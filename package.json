{
  "name": "wastelandmaps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "seo": "npx --yes esbuild _tools/build-seo.ts --bundle --platform=node --format=esm --define:import.meta.env={} --log-level=error --outfile=_data/build-seo.mjs && node _data/build-seo.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "app:sync": "npm run build && cap sync",
    "app:assets": "capacitor-assets generate",
    "app:android": "npm run app:sync && cap open android",
    "app:ios": "npm run app:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@types/google.maps": "^3.66.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "patch-package": "^8.0.0",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
